---
import { getCollection, getEntry } from 'astro:content';
import { getStateSlug } from '../../utils/stateMap';
import { parseSpintax, applySpintaxToObj, createRNG } from '../../utils/spintax';
import { marked } from 'marked';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LocalizedHero from '../../components/modules/LocalizedHero.astro';
import SplitContent from '../../components/modules/SplitContent.astro';
import CommonProblems from '../../components/modules/CommonProblems.astro';
import ProcessSteps from '../../components/modules/ProcessSteps.astro';
import WhyItMatters from '../../components/modules/WhyItMatters.astro';
import RepairVsReplace from '../../components/modules/RepairVsReplace.astro';
import ServiceGrid from '../../components/modules/ServiceGrid.astro';
import ServiceAreaContext from '../../components/modules/ServiceAreaContext.astro';
import FAQSection from '../../components/modules/FAQSection.astro';
import CTASection from '../../components/modules/CTASection.astro';

export async function getStaticPaths() {
  const locations = await getCollection('locations');
  const services = await getCollection('services');

  let activeLocations = locations.filter(loc => loc.data.status === 'priority' || loc.data.status === 'indexable');

  const paths = [];

  for (const location of activeLocations) {
    for (const service of services) {
      const citySlug = location.data.slug.split('/')[1];
      const state = getStateSlug(location.data.state);
      // Service slug + city slug = URL (e.g., garage-door-repair-doylestown)
      const slug = `${service.id}-${citySlug}`;

      paths.push({
        params: { state, slug },
        props: {
          location: location.data,
          rawService: service.data,
          serviceId: service.id,
          citySlug,
          stateSlug: state
        }
      });
    }
  }

  return paths;
}

const { location, rawService, serviceId, citySlug, stateSlug } = Astro.props;

// Use the city+state+service as a deterministic seed
const seed = `${location.city}-${location.state}-${serviceId}`;
const rng = createRNG(seed);
const service = applySpintaxToObj(rawService, rng);

// Process templates
const pageTitle = service.seo.titleTemplate
  .replace('{City}', location.city)
  .replace('{State}', location.state.toUpperCase());

const metaDesc = service.seo.metaDescriptionTemplate
  .replace('{City}', location.city)
  .replace('{State}', location.state.toUpperCase());

const h1 = service.seo.h1Template
  .replace('{City}', location.city)
  .replace('{State}', location.state.toUpperCase());

const heroSubtitle = service.hero.subtitleTemplate
  .replace('{City}', location.city)
  .replace('{State}', location.state.toUpperCase());

// Load and parse the markdown body dynamically with spintax
const serviceEntry = await getEntry('services', serviceId);
const spunBody = parseSpintax(serviceEntry.body, rng);
const spunHtml = marked.parse(spunBody);

// Show repair vs replace only if the service is a general repair or replacement
const showRepairVsReplace = ['garage-door-repair', 'garage-door-replacement'].includes(serviceId);

const overviewImages = {
  'emergency-garage-door-repair': '/images/split_emergency.jpg',
  'garage-door-installation': '/images/split_install.jpg',
  'garage-door-opener-installation': '/images/split_opener_install.jpg',
  'garage-door-opener-repair': '/images/split_opener_repair.jpg',
  'garage-door-repair': '/images/hero_homepage.jpg',
  'garage-door-replacement': '/images/hero_installation.jpg',
  'garage-door-spring-repair': '/images/hero_emergency_repair.jpg'
};
const overviewImage = overviewImages[serviceId] || '/images/hero_homepage.jpg';
---

<BaseLayout title={pageTitle} description={metaDesc}>
  
  <LocalizedHero 
    eyebrow="Local Service Expert"
    h1Template={service.seo.h1Template}
    subtitleTemplate={service.hero.subtitleTemplate}
    imageSrc={service.hero.imageSrc}
    imageAlt={service.hero.imageAlt}
    city={location.city}
    state={location.state}
  />

  <SplitContent 
    eyebrow="Local Overview"
    headline={`Professional ${service.title} in ${location.city}`}
    imageSrc={overviewImage}
    imageAlt={`Beautiful residential garage door in ${location.city}, ${location.state.toUpperCase()}`}
    imageRight={false}
  >
    <div class="prose prose-lg text-gray-700 font-sans" set:html={spunHtml}></div>
  </SplitContent>

  {service.commonProblems && service.commonProblems.length > 0 && (
    <CommonProblems eyebrow="Warning Signs" problems={service.commonProblems} city={location.city} state={location.state.toUpperCase()} />
  )}

  {service.process && service.process.length > 0 && (
    <ProcessSteps eyebrow="How It Works" steps={service.process} bg="alabaster" headline={`The ${service.title} Process`} />
  )}

  {service.benefits && service.benefits.length > 0 && (
    <WhyItMatters eyebrow="Why It Matters" benefits={service.benefits} bg="white" headline={`Benefits of Professional ${service.title}`} />
  )}

  {showRepairVsReplace && (
    <RepairVsReplace eyebrow="Decision Guide" bg="alabaster" />
  )}

  <ServiceAreaContext 
    city={location.city}
    state={location.state.toUpperCase()}
    zips={location.zips}
    serviceTitle={service.title}
  />

  <ServiceGrid eyebrow="More Services" headline="Explore Related Services" subheadline="Comprehensive solutions for every component of your garage door system." currentServiceId={serviceId} stateSlug={stateSlug} citySlug={citySlug} />

  {service.faqs && service.faqs.length > 0 && (
    <FAQSection eyebrow="Service FAQs" faqs={service.faqs} city={location.city} state={location.state.toUpperCase()} />
  )}

  <CTASection headline={`Ready for Reliable Garage Door Service in ${location.city}?`} subheadline={`Join thousands of homeowners who trust Kivo for their repair and installation needs.`} />

</BaseLayout>
