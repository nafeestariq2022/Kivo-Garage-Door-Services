---
import { getCollection } from 'astro:content';
import { parseSpintax, applySpintaxToObj, createRNG } from '../../utils/spintax';
import { marked } from 'marked';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import Hero from '../../components/Hero.astro';
import SplitContent from '../../components/modules/SplitContent.astro';
import CommonProblems from '../../components/modules/CommonProblems.astro';
import ProcessSteps from '../../components/modules/ProcessSteps.astro';
import WhyItMatters from '../../components/modules/WhyItMatters.astro';
import RepairVsReplace from '../../components/modules/RepairVsReplace.astro';
import ServiceGrid from '../../components/modules/ServiceGrid.astro';
import CoverageList from '../../components/modules/CoverageList.astro';
import FAQSection from '../../components/modules/FAQSection.astro';
import CTASection from '../../components/modules/CTASection.astro';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map(service => ({
    params: { slug: service.id },
    props: { serviceEntry: service }
  }));
}

const { serviceEntry } = Astro.props;

// Use the service ID as a deterministic seed for national pages
const rng = createRNG(`national-${serviceEntry.id}`);
const service = applySpintaxToObj(serviceEntry.data, rng);

const spunBody = parseSpintax(serviceEntry.body, rng);
const spunHtml = marked.parse(spunBody);

// For national pages, we remove the city/state placeholders
const pageTitle = service.seo.titleTemplate.replace(' in {City}, {State}', '');
const metaDesc = service.seo.metaDescriptionTemplate.replace(' in {City}, {State}', '');
const h1 = service.seo.h1Template.replace(' in {City}, {State}', '');
const heroSubtitle = service.hero.subtitleTemplate.replace(' for homeowners in {City}, {State},', '');

const showRepairVsReplace = ['garage-door-repair', 'garage-door-replacement'].includes(serviceEntry.id);

const overviewImages = {
  'emergency-garage-door-repair': '/images/split_emergency.jpg',
  'garage-door-installation': '/images/split_install.jpg',
  'garage-door-opener-installation': '/images/split_opener_install.jpg',
  'garage-door-opener-repair': '/images/split_opener_repair.jpg',
  'garage-door-repair': '/images/hero_homepage.jpg',
  'garage-door-replacement': '/images/hero_installation.jpg',
  'garage-door-spring-repair': '/images/hero_emergency_repair.jpg'
};
const overviewImage = overviewImages[serviceEntry.id] || '/images/hero_homepage.jpg';
---

<BaseLayout title={pageTitle} description={metaDesc}>
  
  <Breadcrumbs crumbs={[
    { label: 'Services', href: '/services' },
    { label: service.title }
  ]} />

  <Hero 
    eyebrow="Specialized Service"
    headline={h1}
    subheadline={heroSubtitle}
    imageSrc={service.hero.imageSrc}
    imageAlt={service.hero.imageAlt}
  />

  <SplitContent 
    eyebrow="Service Overview"
    headline={`Professional ${service.title}`}
    imageSrc={overviewImage}
    imageAlt={`Beautiful residential garage door`}
    imageRight={false}
  >
    <div class="prose prose-lg text-gray-700 font-sans" set:html={spunHtml}></div>
  </SplitContent>

  {service.commonProblems && service.commonProblems.length > 0 && (
    <CommonProblems eyebrow="Warning Signs" problems={service.commonProblems} />
  )}

  {service.process && service.process.length > 0 && (
    <ProcessSteps eyebrow="How It Works" steps={service.process} bg="alabaster" headline={`The ${service.title} Process`} />
  )}

  {service.benefits && service.benefits.length > 0 && (
    <WhyItMatters eyebrow="Why It Matters" benefits={service.benefits} bg="white" headline={`Benefits of Professional ${service.title}`} />
  )}

  {showRepairVsReplace && (
    <RepairVsReplace eyebrow="Decision Guide" bg="alabaster" />
  )}

  <CoverageList eyebrow="Service Areas" headline="National Coverage Areas" />

  <ServiceGrid eyebrow="More Services" headline="Explore Related Services" currentServiceId={serviceEntry.id} />

  {service.faqs && service.faqs.length > 0 && (
    <FAQSection eyebrow="Service FAQs" faqs={service.faqs} />
  )}

  <CTASection headline="Ready to Restore Your Door?" subheadline="Join thousands of homeowners who trust Kivo for their garage door needs." />

</BaseLayout>
