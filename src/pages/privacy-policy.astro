---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Privacy Policy | Kivo Garage Door Services" description="Privacy Policy for Kivo Garage Door Services.">
  <div class="py-24 max-w-4xl mx-auto px-4 font-sans text-gray-700">
    <h1 class="text-4xl font-heading font-bold text-brand-charcoal mb-8">Privacy Policy</h1>
    <p class="mb-4">This privacy policy explains how we collect, use, and protect your information when you request garage door services through our website.</p>
    <p>By using our contact forms or calling our service line, you consent to being connected with a local garage door service professional in your area. We do not sell your data to third parties outside of this service-connection scope.</p>
  </div>
</BaseLayout>
