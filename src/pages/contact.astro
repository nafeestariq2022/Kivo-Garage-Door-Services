---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProcessSteps from '../components/modules/ProcessSteps.astro';
import CoverageList from '../components/modules/CoverageList.astro';
import FAQSection from '../components/modules/FAQSection.astro';
import PhoneCTA from '../components/ui/PhoneCTA.astro';

const genericProcess = [
  { title: "1. Prompt Dispatch", description: "When you call, a professional technician is dispatched to your property to assess the situation." },
  { title: "2. Thorough Diagnostic", description: "The technician inspects the door's hardware, balance, and motor to identify the root cause." },
  { title: "3. Clear Options", description: "You receive a straightforward explanation of the problem and professional recommendations." },
  { title: "4. Lasting Resolution", description: "The repair or installation is completed using high-quality parts, followed by rigorous safety testing." }
];

const contactFaqs = [
  { question: "What information should I have ready when I call?", answer: "It is helpful to know if the door is completely stuck, if a spring looks broken, or if the opener motor is making noise. If you know the brand of your opener or door, mention that as well." },
  { question: "Do you provide emergency service?", answer: "Yes, we dispatch technicians for emergency repairs when your door is stuck open, off-track, or otherwise posing a security risk." },
  { question: "Can I schedule a new door installation estimate?", answer: "Absolutely. Call our service line and we will arrange a consultation to discuss materials, styles, and measurements for your new garage door." }
];
---

<BaseLayout 
  title="Contact Kivo Garage Door Services | Get Help Now"
  description="Contact Kivo Garage Door Services for professional repair, emergency service, or new installation. Call now for immediate assistance."
>
  <Hero 
    eyebrow="Get In Touch"
    headline="CONTACT US."
    subheadline="Fast, professional garage door repair and installation is just a phone call away."
    imageSrc="/images/hero_emergency_repair.jpg"
    imageAlt="Technician servicing a garage door"
  />

  <section class="py-20 md:py-32 bg-brand-alabaster relative overflow-hidden">
    <!-- Background Accents -->
    <div class="absolute top-0 right-0 w-[800px] h-[800px] bg-brand-accent/5 rounded-full mix-blend-multiply filter blur-[100px] transform translate-x-1/3 -translate-y-1/3 pointer-events-none"></div>

    <div class="max-w-[90rem] mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-start">
        
        <!-- Phone CTA Column -->
        <div class="sticky top-32">
          <div class="flex items-center gap-3 text-sm font-sans font-bold text-gray-500 uppercase tracking-widest mb-6">
            <span class="w-2 h-2 bg-brand-accent rounded-full animate-pulse"></span>
            <span>Fastest Response</span>
          </div>
          <h2 class="text-4xl md:text-5xl font-heading font-black text-brand-charcoal mb-8 uppercase tracking-tight leading-[1.1]">Need Immediate Service?</h2>
          <p class="text-xl text-gray-600 font-sans leading-relaxed mb-12">The fastest way to get your garage door fixed is to call our dispatch line. We will connect you with a professional technician in your area immediately.</p>
          
          <div class="p-10 md:p-12 bg-brand-charcoal rounded-[2.5rem] text-center shadow-2xl relative overflow-hidden border border-white/10 group">
            <div class="absolute top-0 right-0 w-48 h-48 bg-brand-accent rounded-full mix-blend-screen filter blur-[80px] opacity-20 group-hover:opacity-40 transition-opacity duration-500"></div>
            
            <div class="w-16 h-16 mx-auto bg-white/5 rounded-full flex items-center justify-center mb-6 border border-white/10 text-brand-accent">
               <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
            </div>
            
            <h3 class="text-2xl font-heading font-bold text-white mb-8">Call Our Service Line</h3>
            <div class="inline-block p-1.5 rounded-full bg-white/10 backdrop-blur-md">
              <PhoneCTA label="Call Now" class="!px-10 !py-4 !shadow-none" />
            </div>
          </div>
        </div>

        <!-- Contact Form Column -->
        <div class="bg-white p-10 md:p-14 rounded-[3rem] shadow-xl border border-gray-100 relative">
          <div class="flex items-center gap-3 text-sm font-sans font-bold text-gray-500 uppercase tracking-widest mb-6">
            <span class="w-2 h-2 bg-brand-accent rounded-full"></span>
            <span>General Inquiries</span>
          </div>
          <h2 class="text-3xl md:text-4xl font-heading font-black text-brand-charcoal mb-4 uppercase tracking-tight leading-tight">Send a Message</h2>
          <p class="text-lg text-gray-600 font-sans leading-relaxed mb-10">For non-urgent inquiries, please fill out the form below and a representative will get back to you.</p>
          
          <form class="space-y-6" onsubmit="event.preventDefault(); alert('Form submission is currently disabled. Please call us directly for service.');">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label for="firstName" class="block text-sm font-bold text-gray-700 font-sans mb-2 pl-2">First Name</label>
                <input type="text" id="firstName" class="w-full bg-brand-alabaster rounded-2xl border-transparent focus:border-brand-accent focus:bg-white focus:ring-2 focus:ring-brand-accent focus:ring-offset-2 p-4 transition-all" required>
              </div>
              <div>
                <label for="lastName" class="block text-sm font-bold text-gray-700 font-sans mb-2 pl-2">Last Name</label>
                <input type="text" id="lastName" class="w-full bg-brand-alabaster rounded-2xl border-transparent focus:border-brand-accent focus:bg-white focus:ring-2 focus:ring-brand-accent focus:ring-offset-2 p-4 transition-all" required>
              </div>
            </div>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label for="email" class="block text-sm font-bold text-gray-700 font-sans mb-2 pl-2">Email Address</label>
                <input type="email" id="email" class="w-full bg-brand-alabaster rounded-2xl border-transparent focus:border-brand-accent focus:bg-white focus:ring-2 focus:ring-brand-accent focus:ring-offset-2 p-4 transition-all" required>
              </div>
              <div>
                <label for="phone" class="block text-sm font-bold text-gray-700 font-sans mb-2 pl-2">Phone Number</label>
                <input type="tel" id="phone" class="w-full bg-brand-alabaster rounded-2xl border-transparent focus:border-brand-accent focus:bg-white focus:ring-2 focus:ring-brand-accent focus:ring-offset-2 p-4 transition-all" required>
              </div>
            </div>

            <div>
              <label for="serviceType" class="block text-sm font-bold text-gray-700 font-sans mb-2 pl-2">How can we help?</label>
              <div class="relative">
                <select id="serviceType" class="w-full appearance-none bg-brand-alabaster rounded-2xl border-transparent focus:border-brand-accent focus:bg-white focus:ring-2 focus:ring-brand-accent focus:ring-offset-2 p-4 transition-all text-gray-700">
                  <option>Garage Door Repair</option>
                  <option>Garage Door Replacement</option>
                  <option>New Installation</option>
                  <option>Opener Repair</option>
                  <option>Other</option>
                </select>
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-gray-500">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                </div>
              </div>
            </div>
            
            <div>
              <label for="message" class="block text-sm font-bold text-gray-700 font-sans mb-2 pl-2">Message</label>
              <textarea id="message" rows="4" class="w-full bg-brand-alabaster rounded-2xl border-transparent focus:border-brand-accent focus:bg-white focus:ring-2 focus:ring-brand-accent focus:ring-offset-2 p-4 transition-all resize-none" required></textarea>
            </div>
            
            <button type="submit" class="w-full bg-brand-charcoal text-white font-bold font-sans uppercase tracking-widest py-5 px-8 rounded-full hover:bg-brand-accent hover:shadow-lg transform hover:-translate-y-1 transition-all duration-300 mt-4 shadow-md">
              Submit Request
            </button>
          </form>
        </div>

      </div>
    </div>
  </section>

  <ProcessSteps eyebrow="The Process" steps={genericProcess} bg="alabaster" headline="What Happens After You Contact Us" />

  <CoverageList eyebrow="Service Areas" />

  <FAQSection eyebrow="Contact FAQs" faqs={contactFaqs} />

</BaseLayout>
