---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ServiceGrid from '../components/modules/ServiceGrid.astro';
import WhyItMatters from '../components/modules/WhyItMatters.astro';
import SplitContent from '../components/modules/SplitContent.astro';
import ProcessSteps from '../components/modules/ProcessSteps.astro';
import RepairVsReplace from '../components/modules/RepairVsReplace.astro';
import CoverageList from '../components/modules/CoverageList.astro';
import FAQSection from '../components/modules/FAQSection.astro';
import PhoneCTA from '../components/ui/PhoneCTA.astro';
import CTASection from '../components/modules/CTASection.astro';

const genericProcess = [
  { title: "1. Prompt Dispatch", description: "When you call, a professional local technician is quickly dispatched to your property to assess the situation." },
  { title: "2. Thorough Diagnostic", description: "The technician inspects your door's hardware, balance, and motor to identify the root mechanical failure." },
  { title: "3. Clear Solutions", description: "You receive a straightforward explanation of the problem alongside professional, upfront recommendations for repair." },
  { title: "4. Lasting Resolution", description: "The repair or installation is completed using high-quality parts, followed by rigorous safety testing to ensure long-term reliability." }
];

const genericBenefits = [
  { title: "Experienced Professionals", description: "You receive service from established garage door experts who understand local building codes and safety standards." },
  { title: "Comprehensive Diagnostics", description: "We don't just treat symptoms. Thorough diagnostics identify root mechanical failures to prevent future breakdowns." },
  { title: "Home Security & Value", description: "A broken door is a massive security vulnerability. Prompt professional service restores your home's defensive perimeter and operational value." }
];

const homeFaqs = [
  { question: "Why won't my garage door open?", answer: "The most common reasons are a snapped torsion spring, a broken lift cable, a stripped opener gear, or a simple power failure. A professional diagnostic can pinpoint the exact cause safely." },
  { question: "How long do garage door springs last?", answer: "Standard torsion springs are rated for approximately 10,000 cycles (opening and closing). For most households, this translates to about 7 to 10 years of typical use before they inevitably snap." },
  { question: "Can a damaged panel be replaced without buying a new door?", answer: "Yes. If a single panel is dented or damaged, it can often be ordered and swapped out, provided the door model is still being manufactured and the rest of the structure is sound." },
  { question: "Is it dangerous to fix a garage door myself?", answer: "Yes. The springs and cables hold an immense amount of stored kinetic energy. Attempting repairs without the proper tools and training can result in severe injury or property damage." },
  { question: "How often should a residential garage door be serviced?", answer: "It is highly recommended to have an annual preventative maintenance check. This includes lubricating moving parts, checking the balance, and inspecting cables and springs for wear." },
  { question: "What should I do if my garage door comes off its tracks?", answer: "Stop using the door immediately and disconnect the automatic opener. Attempting to force the door can cause severe structural damage. Call for professional service to safely realign the track system." }
];
---

<BaseLayout 
  title="Kivo Garage Door Services | Local Repair & Installation Experts"
  description="Kivo Garage Door Services provides reliable, professional garage door repair, replacement, and installation. Get expert help for broken springs and faulty openers today."
>
  <Hero 
    eyebrow="Your Local Garage Door Experts"
    headline="PROFESSIONAL GARAGE DOOR REPAIR & INSTALLATION"
    subheadline="A malfunctioning garage door traps your vehicles and compromises your home's security. Kivo Garage Door Services delivers prompt, permanent solutions to restore your peace of mind and get your day back on track."
    imageSrc="/images/hero_homepage.jpg"
    imageAlt="Premium modern dark wood garage door on a luxury suburban home exterior"
  />

  <ServiceGrid 
    eyebrow="Our Service Coverage" 
    headline="Comprehensive Garage Door Solutions"
  />

  <SplitContent 
    eyebrow="The Kivo Standard"
    headline="TRUSTED LOCAL SERVICE. GUARANTEED EXPERTISE."
    subheadline="We believe your garage door should be the most reliable entry point to your home."
    imageSrc="/images/hero_installation.jpg"
    imageAlt="A pristine modern garage door perfectly installed"
    imageRight={true}
  >
    <p class="text-gray-700 font-sans leading-relaxed mb-4">When a massive moving wall of metal fails, it is more than a minor inconvenience—it is an immediate safety hazard and a major disruption to your day. We focus on diagnosing the root mechanical failure and providing permanent, reliable solutions so you never have to worry about your door getting stuck again.</p>
    <p class="text-gray-700 font-sans leading-relaxed mb-4">Our approach prioritizes safety, long-term mechanical reliability, and structural integrity. Whether you need an emergency torsion spring replacement, a derailed track realigned, or a beautiful new custom door installed, you can trust that the job will be done right the first time.</p>
  </SplitContent>

  <WhyItMatters 
    eyebrow="Why Choose Kivo" 
    headline="The Advantage of Professional Service" 
    benefits={genericBenefits} 
    bg="alabaster" 
  />

  <ProcessSteps 
    eyebrow="How It Works" 
    headline="Our Seamless Service Process" 
    steps={genericProcess} 
    bg="white" 
  />

  <RepairVsReplace 
    eyebrow="Decision Guide" 
    bg="alabaster" 
  />

  <CTASection 
    headline="Ready for Reliable Garage Door Service?" 
    subheadline="Join thousands of homeowners who trust Kivo for their repair and installation needs." 
  />

  <CoverageList eyebrow="Service Areas" />

  <FAQSection eyebrow="Homeowner Questions" faqs={homeFaqs} />

</BaseLayout>
