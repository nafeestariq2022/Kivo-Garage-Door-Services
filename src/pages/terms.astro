---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Terms of Service | Kivo Garage Door Services" description="Terms of Service for Kivo Garage Door Services.">
  <div class="py-24 max-w-4xl mx-auto px-4 font-sans text-gray-700">
    <h1 class="text-4xl font-heading font-bold text-brand-charcoal mb-8">Terms of Service</h1>
    <p class="mb-4">Welcome to Kivo Garage Door Services. By accessing our website and requesting service, you agree to these terms.</p>
    <p>We act as a connection network to link homeowners with independent, professional garage door technicians. All services, guarantees, and pricing are provided directly by the independent contractor who performs the work.</p>
  </div>
</BaseLayout>
