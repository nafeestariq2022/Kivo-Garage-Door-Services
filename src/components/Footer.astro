---
import PhoneCTA from './ui/PhoneCTA.astro';

const year = new Date().getFullYear();

const services = [
  { name: 'Emergency Garage Door Repair', href: '/services/emergency-garage-door-repair/' },
  { name: 'General Garage Door Repair', href: '/services/garage-door-repair/' },
  { name: 'Garage Door Installation', href: '/services/garage-door-installation/' },
  { name: 'Garage Door Replacement', href: '/services/garage-door-replacement/' },
  { name: 'Opener Repair', href: '/services/garage-door-opener-repair/' },
  { name: 'Opener Installation', href: '/services/garage-door-opener-installation/' },
  { name: 'Spring Repair', href: '/services/garage-door-spring-repair/' },
];

const locations = [
  { name: 'Pennsylvania', href: '/pa/' },
  { name: 'North Carolina', href: '/nc/' },
  { name: 'Indiana', href: '/in/' },
  { name: 'California', href: '/ca/' },
  { name: 'Texas', href: '/tx/' },
  { name: 'Kansas', href: '/ks/' },
];
---

<footer class="bg-black text-white relative overflow-hidden pt-24 pb-12 border-t border-white/10">
  <!-- Giant Background Watermark -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-[25vw] font-heading font-black text-white/[0.02] pointer-events-none select-none tracking-tighter whitespace-nowrap z-0">
    KIVO
  </div>
  
  <div class="max-w-[90rem] mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-12 lg:gap-8 mb-20">
      
      <!-- Brand & CTA (takes 4 cols) -->
      <div class="lg:col-span-4 pr-8">
        <a href="/" class="text-4xl font-heading font-black text-white focus:outline-none focus:ring-2 focus:ring-brand-accent inline-flex items-baseline mb-6 tracking-tight">
          KIVO<span class="text-brand-accent">.</span>
        </a>
        <p class="font-sans text-gray-400 text-lg leading-relaxed mb-8">
          Connecting homeowners with highly trained, professional garage door technicians. Reliable repairs and premium installations.
        </p>
        <PhoneCTA label="Call for Service" class="w-full justify-center !py-4" />
      </div>

      <!-- Services (takes 3 cols) -->
      <div class="lg:col-span-3 lg:col-start-6">
        <h3 class="font-heading text-lg font-bold text-white mb-6 uppercase tracking-widest flex items-center gap-2">
          <span class="w-2 h-2 bg-brand-accent rounded-full"></span>
          Services
        </h3>
        <ul class="space-y-4 font-sans">
          {services.map(service => (
             <li>
               <a href={service.href} class="group flex items-center text-gray-400 hover:text-white transition-colors">
                 <span class="text-brand-accent opacity-0 -ml-4 group-hover:opacity-100 group-hover:ml-0 transition-all duration-300 mr-2">&rarr;</span>
                 <span class="transform group-hover:translate-x-1 transition-transform duration-300">{service.name}</span>
               </a>
             </li>
          ))}
        </ul>
      </div>

      <!-- Locations (takes 2 cols) -->
      <div class="lg:col-span-2">
        <h3 class="font-heading text-lg font-bold text-white mb-6 uppercase tracking-widest flex items-center gap-2">
          <span class="w-2 h-2 bg-brand-accent rounded-full"></span>
          Locations
        </h3>
        <ul class="space-y-4 font-sans">
          {locations.map(loc => (
             <li>
               <a href={loc.href} class="group flex items-center text-gray-400 hover:text-white transition-colors">
                 <span class="text-brand-accent opacity-0 -ml-4 group-hover:opacity-100 group-hover:ml-0 transition-all duration-300 mr-2">&rarr;</span>
                 <span class="transform group-hover:translate-x-1 transition-transform duration-300">{loc.name}</span>
               </a>
             </li>
          ))}
        </ul>
      </div>

      <!-- Company & Legal (takes 2 cols) -->
      <div class="lg:col-span-2">
        <h3 class="font-heading text-lg font-bold text-white mb-6 uppercase tracking-widest flex items-center gap-2">
          <span class="w-2 h-2 bg-brand-accent rounded-full"></span>
          Company
        </h3>
        <ul class="space-y-4 font-sans mb-10">
          <li>
             <a href="/about" class="group flex items-center text-gray-400 hover:text-white transition-colors">
               <span class="text-brand-accent opacity-0 -ml-4 group-hover:opacity-100 group-hover:ml-0 transition-all duration-300 mr-2">&rarr;</span>
               <span class="transform group-hover:translate-x-1 transition-transform duration-300">About Kivo</span>
             </a>
          </li>
          <li>
             <a href="/contact" class="group flex items-center text-gray-400 hover:text-white transition-colors">
               <span class="text-brand-accent opacity-0 -ml-4 group-hover:opacity-100 group-hover:ml-0 transition-all duration-300 mr-2">&rarr;</span>
               <span class="transform group-hover:translate-x-1 transition-transform duration-300">Contact Us</span>
             </a>
          </li>
        </ul>

        <h3 class="font-heading text-lg font-bold text-white mb-6 uppercase tracking-widest flex items-center gap-2">
          <span class="w-2 h-2 bg-brand-accent rounded-full"></span>
          Legal
        </h3>
        <ul class="space-y-4 font-sans">
          <li>
             <a href="/privacy-policy" class="group flex items-center text-gray-400 hover:text-white transition-colors">
               <span class="text-brand-accent opacity-0 -ml-4 group-hover:opacity-100 group-hover:ml-0 transition-all duration-300 mr-2">&rarr;</span>
               <span class="transform group-hover:translate-x-1 transition-transform duration-300">Privacy Policy</span>
             </a>
          </li>
          <li>
             <a href="/terms" class="group flex items-center text-gray-400 hover:text-white transition-colors">
               <span class="text-brand-accent opacity-0 -ml-4 group-hover:opacity-100 group-hover:ml-0 transition-all duration-300 mr-2">&rarr;</span>
               <span class="transform group-hover:translate-x-1 transition-transform duration-300">Terms of Service</span>
             </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-6 text-sm text-gray-500 font-sans">
      <p class="flex items-center gap-2">
        <span class="w-1.5 h-1.5 bg-green-500 rounded-full animate-pulse shadow-[0_0_8px_rgba(34,197,94,0.6)]"></span>
        &copy; {year} Kivo Garage Door Services. All rights reserved.
      </p>
      <div class="flex items-center gap-4 sm:gap-6 flex-wrap justify-center">
        <span class="hover:text-white transition-colors cursor-default">Professional</span>
        <span class="w-1 h-1 bg-gray-700 rounded-full"></span>
        <span class="hover:text-white transition-colors cursor-default">Residential</span>
        <span class="w-1 h-1 bg-gray-700 rounded-full"></span>
        <span class="hover:text-white transition-colors cursor-default">Guaranteed</span>
      </div>
    </div>
  </div>
</footer>
