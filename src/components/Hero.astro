---
import PhoneCTA from './ui/PhoneCTA.astro';
import Container from './ui/Container.astro';
import Eyebrow from './ui/Eyebrow.astro';

interface Props {
  eyebrow?: string;
  headline: string;
  subheadline: string;
  imageSrc: string;
  imageAlt: string;
}
const { eyebrow, headline, subheadline, imageSrc, imageAlt } = Astro.props;
---
<section class="relative w-full bg-brand-alabaster pt-12 pb-20 lg:pt-24 lg:pb-32 overflow-hidden">
  <Container class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
    <!-- Asymmetrical Left: Typography -->
    <div class="lg:col-span-6 z-10 lg:pr-4 flex flex-col items-start">
      {eyebrow && <Eyebrow text={eyebrow} />}
      <h1 class="text-4xl md:text-5xl lg:text-6xl xl:text-[4.5rem] 2xl:text-7xl font-heading font-bold text-brand-charcoal leading-[1.05] uppercase tracking-tight">
        {headline}
      </h1>
      <p class="mt-8 text-lg lg:text-xl font-sans text-gray-700 leading-relaxed max-w-2xl">
        {subheadline}
      </p>
      <div class="mt-10 flex flex-col sm:flex-row gap-4">
        <PhoneCTA label="Call for Garage Door Service" />
      </div>
      <div class="mt-10 flex items-center gap-4 text-sm font-sans font-medium text-gray-600 uppercase tracking-widest flex-wrap">
        <span>Professional</span>
        <span class="w-1.5 h-1.5 bg-brand-accent rounded-sm"></span>
        <span>Reliable</span>
        <span class="w-1.5 h-1.5 bg-brand-accent rounded-sm"></span>
        <span>Secure</span>
      </div>
    </div>
    
    <!-- Asymmetrical Right: Image (No Dark Overlay) -->
    <div class="lg:col-span-6 relative mt-12 lg:mt-0">
      <div class="relative w-full aspect-square lg:aspect-[4/3]">
        <img src={imageSrc} alt={imageAlt} class="absolute inset-0 object-cover w-full h-full rounded-sm shadow-xl" loading="eager" />
      </div>
      <!-- Decorative strict geometry element -->
      <div class="absolute -bottom-6 -left-6 w-32 h-32 border-l-4 border-b-4 border-brand-accent hidden lg:block z-0"></div>
    </div>
  </Container>
</section>
