---
import PhoneCTA from './ui/PhoneCTA.astro';
import Container from './ui/Container.astro';
import Eyebrow from './ui/Eyebrow.astro';

interface Props {
  eyebrow?: string;
  headline: string;
  subheadline: string;
  imageSrc: string;
  imageAlt: string;
}
const { eyebrow, headline, subheadline, imageSrc, imageAlt } = Astro.props;
---
<section class="relative w-full pt-16 pb-24 lg:pt-32 lg:pb-40 overflow-hidden bg-gradient-to-br from-brand-alabaster via-white to-gray-50">
  <!-- Modern subtle background glow -->
  <div class="absolute top-0 left-0 w-full h-full overflow-hidden z-0 pointer-events-none">
    <div class="absolute -top-[20%] -left-[10%] w-[50%] h-[50%] rounded-full bg-brand-accent/5 blur-[120px]"></div>
    <div class="absolute top-[40%] -right-[10%] w-[40%] h-[60%] rounded-full bg-brand-charcoal/5 blur-[120px]"></div>
  </div>

  <Container class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-16 lg:gap-20 items-center">
    <!-- Left: Typography -->
    <div class="lg:col-span-6 flex flex-col items-start">
      {eyebrow && <Eyebrow text={eyebrow} />}
      <h1 class="text-4xl md:text-5xl lg:text-6xl xl:text-[4.5rem] 2xl:text-7xl font-heading font-black text-brand-charcoal leading-[1.1] uppercase tracking-tight">
        {headline}
      </h1>
      <p class="mt-6 text-lg lg:text-xl font-sans text-gray-600 leading-relaxed max-w-2xl">
        {subheadline}
      </p>
      <div class="mt-10 flex flex-col sm:flex-row gap-4">
        <PhoneCTA label="Call for Garage Door Service" />
      </div>
      
      <!-- Unified Trust Bar -->
      <div class="mt-10 sm:mt-12 inline-flex flex-wrap items-center gap-3 sm:gap-6 px-6 sm:px-8 py-3.5 bg-white rounded-2xl sm:rounded-full shadow-[0_8px_30px_rgb(0,0,0,0.06)] border border-gray-100">
        <div class="flex items-center gap-2">
          <div class="w-5 h-5 rounded-full bg-brand-accent/10 flex items-center justify-center text-brand-accent">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>
          </div>
          <span class="text-sm font-bold text-brand-charcoal tracking-wide">Professional</span>
        </div>
        
        <div class="hidden sm:block w-1.5 h-1.5 rounded-full bg-gray-200"></div>
        
        <div class="flex items-center gap-2">
          <div class="w-5 h-5 rounded-full bg-brand-accent/10 flex items-center justify-center text-brand-accent">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>
          </div>
          <span class="text-sm font-bold text-brand-charcoal tracking-wide">Reliable</span>
        </div>
        
        <div class="hidden sm:block w-1.5 h-1.5 rounded-full bg-gray-200"></div>
        
        <div class="flex items-center gap-2">
          <div class="w-5 h-5 rounded-full bg-brand-accent/10 flex items-center justify-center text-brand-accent">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>
          </div>
          <span class="text-sm font-bold text-brand-charcoal tracking-wide">Secure</span>
        </div>
      </div>
    </div>
    
    <!-- Right: Image with Floating Glassmorphism Element -->
    <div class="lg:col-span-6 relative mt-12 lg:mt-0 group perspective">
      <div class="relative w-full aspect-square lg:aspect-[4/3] rounded-3xl overflow-hidden shadow-2xl ring-4 ring-white transition-transform duration-700 ease-out group-hover:scale-[1.02]">
        <img src={imageSrc} alt={imageAlt} class="absolute inset-0 object-cover w-full h-full transition-transform duration-1000 ease-in-out group-hover:scale-105" loading="eager" />
      </div>
      
      <!-- Floating Glassmorphism Review Badge -->
      <div class="absolute -bottom-8 -left-8 md:bottom-8 md:-left-12 bg-white/80 backdrop-blur-md border border-white/50 shadow-xl rounded-2xl p-5 flex items-center gap-4 z-20 animate-fade-in-up">
        <div class="flex-shrink-0 w-12 h-12 bg-brand-accent rounded-full flex items-center justify-center text-white">
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
        </div>
        <div>
          <div class="flex text-brand-accent-alt mb-1">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
          </div>
          <p class="text-sm font-bold text-brand-charcoal">5-Star Rated Service</p>
          <p class="text-xs text-gray-500 font-medium mt-0.5">Trusted by hundreds</p>
        </div>
      </div>
    </div>
  </Container>
</section>
