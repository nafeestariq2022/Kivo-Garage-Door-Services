---
import PhoneCTA from './PhoneCTA.astro';

interface Props {
  phone: string;
}

const { phone } = Astro.props;
---

<div class="fixed bottom-0 left-0 w-full bg-white border-t border-gray-200 p-4 shadow-2xl z-50 md:hidden flex justify-center">
  <PhoneCTA phone={phone} label="Call for Service" class="w-full justify-center py-4 text-lg" />
</div>

<!-- Spacer to prevent content from hiding behind the sticky footer on mobile -->
<div class="h-24 md:hidden block"></div>
