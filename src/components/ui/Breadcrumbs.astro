---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  crumbs: Crumb[];
  centered?: boolean;
}

const { crumbs, centered = false } = Astro.props;
const siteUrl = 'https://kivogaragedoorservices.com';

// Prepend Home to the list for Schema generation
const fullPath = [{ label: 'Home', href: '/' }, ...crumbs];

const schema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": fullPath.map((crumb, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": crumb.label,
    "item": crumb.href ? `${siteUrl}${crumb.href === '/' ? '' : crumb.href}` : undefined
  }))
};
---

<nav aria-label="Breadcrumb" class={`mb-4 w-full ${centered ? 'flex justify-center' : ''}`}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
  <div class={`flex items-center gap-4 text-sm font-sans font-medium text-brand-accent uppercase tracking-widest overflow-x-auto whitespace-nowrap ${centered ? 'justify-center' : ''}`}>
    <span class="w-8 h-[2px] bg-brand-accent flex-shrink-0"></span>
    <ol class="flex items-center space-x-2">
      <li>
        <a href="/" class="opacity-80 hover:opacity-100 transition-opacity focus:outline-none focus:underline">Home</a>
      </li>
      {crumbs.map((crumb, i) => (
        <li class="flex items-center space-x-2">
          <span class="text-brand-accent/50">/</span>
          {crumb.href && i !== crumbs.length - 1 ? (
            <a href={crumb.href} class="opacity-80 hover:opacity-100 transition-opacity focus:outline-none focus:underline">{crumb.label}</a>
          ) : (
            <span aria-current="page">{crumb.label}</span>
          )}
        </li>
      ))}
    </ol>
    {centered && <span class="w-8 h-[2px] bg-brand-accent flex-shrink-0 hidden sm:block"></span>}
  </div>
</nav>
