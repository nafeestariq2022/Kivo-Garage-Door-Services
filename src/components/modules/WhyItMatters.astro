---
import Eyebrow from '../ui/Eyebrow.astro';

interface Benefit {
  title: string;
  description: string;
}

interface Props {
  eyebrow?: string;
  headline?: string;
  benefits: Benefit[];
  bg?: 'white' | 'alabaster';
}

const { eyebrow, headline = "Why Professional Service Matters", benefits, bg = 'white' } = Astro.props;

const bgClass = bg === 'white' ? 'bg-white' : 'bg-brand-alabaster';
---

<section class={`py-20 md:py-32 bg-brand-charcoal relative overflow-hidden`}>
  <!-- Background Glow -->
  <div class="absolute top-0 right-0 w-full h-full overflow-hidden z-0 pointer-events-none">
    <div class="absolute -top-[20%] -right-[10%] w-[50%] h-[50%] rounded-full bg-brand-accent/20 blur-[120px]"></div>
  </div>

  <div class="max-w-[90rem] mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="mb-16 max-w-3xl">
      {eyebrow && <Eyebrow text={eyebrow} className="!text-brand-accent-alt" />}
      <h2 class="text-4xl md:text-5xl font-heading font-black text-white uppercase tracking-tight mb-6">{headline}</h2>
      <p class="text-lg md:text-xl text-gray-400 font-sans leading-relaxed">Addressing garage door issues promptly protects your home, your family, and your schedule.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {benefits.map((benefit, index) => (
        <div class="flex flex-col bg-white/5 border border-white/10 p-10 rounded-3xl backdrop-blur-md hover:bg-white/10 transition-colors duration-300">
          <div class="w-12 h-12 bg-brand-accent/20 rounded-xl flex items-center justify-center mb-6">
            <span class="text-brand-accent font-black text-xl">{index + 1}</span>
          </div>
          <h3 class="text-2xl font-heading font-bold text-white mb-4">{benefit.title}</h3>
          <p class="text-gray-400 font-sans leading-relaxed">{benefit.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
