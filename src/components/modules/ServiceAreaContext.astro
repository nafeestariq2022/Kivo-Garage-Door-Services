---
interface Props {
  city: string;
  state: string;
  zips: string;
  population?: string;
  serviceTitle: string;
}

const { city, state, zips, population, serviceTitle } = Astro.props;

// Convert zips string "12345|12346" to array and format for display
const zipArray = zips ? zips.split('|').filter(z => z.trim().length > 0) : [];
const zipDisplay = zipArray.length > 5 
  ? `${zipArray.slice(0, 5).join(', ')}, and surrounding areas` 
  : zipArray.join(', ');

// Optional population context
const popContext = population && parseInt(population) > 50000 
  ? ` serving the growing community of over ${Number(population).toLocaleString()} residents`
  : '';
---

<section class="py-16 md:py-24 bg-white relative">
  <div class="max-w-[90rem] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-gradient-to-br from-brand-alabaster to-white rounded-[3rem] p-10 md:p-16 border border-gray-100 shadow-xl relative overflow-hidden flex flex-col md:flex-row gap-12 items-center">
      
      <!-- Decorative Map Watermark -->
      <div class="absolute -right-24 -bottom-24 pointer-events-none">
        <svg class="w-[30rem] h-[30rem] text-brand-accent/5 transform -rotate-12" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 010-5 2.5 2.5 0 010 5z"/></svg>
      </div>

      <!-- Icon Column -->
      <div class="hidden md:flex shrink-0 w-24 h-24 bg-brand-charcoal rounded-3xl items-center justify-center shadow-lg relative z-10 transform -rotate-3">
        <svg class="w-10 h-10 text-brand-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
      </div>

      <!-- Content -->
      <div class="relative z-10 max-w-3xl">
        <div class="flex items-center gap-3 mb-4">
          <span class="w-2 h-2 bg-brand-accent rounded-full animate-pulse"></span>
          <span class="text-sm font-bold text-gray-500 uppercase tracking-widest font-sans">Local Coverage</span>
        </div>
        <h2 class="text-3xl md:text-4xl font-heading font-black uppercase text-brand-charcoal mb-6 tracking-tight leading-tight">Service Area Coverage in {city}</h2>
        <p class="text-lg font-sans text-gray-600 leading-relaxed mb-8">
          When you need professional <span class="font-bold text-brand-charcoal">{serviceTitle.toLowerCase()}</span> in {city}, {state}{popContext}, timely response and reliable expertise matter. Kivo Garage Door Services delivers comprehensive solutions designed to handle the specific structural and climate demands of the region. Whether addressing an unexpected breakdown or planning a major exterior upgrade, professional service restores functionality and enhances home security.
        </p>
        
        {zipDisplay && (
          <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm inline-block">
            <h3 class="font-bold font-sans text-brand-charcoal mb-4 flex items-center gap-2">
              <svg class="w-5 h-5 text-brand-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 19v-8.93a2 2 0 01.89-1.664l7-4.666a2 2 0 012.22 0l7 4.666A2 2 0 0121 10.07V19M3 19a2 2 0 002 2h14a2 2 0 002-2M3 19l6.75-4.5M21 19l-6.75-4.5M3 10l6.75 4.5M21 10l-6.75 4.5m0 0l-1.14.76a2 2 0 01-2.22 0l-1.14-.76"></path></svg>
              Servicing Zip Codes
            </h3>
            <div class="flex flex-wrap gap-2">
              {zipArray.slice(0, 5).map(zip => (
                <span class="px-3 py-1 bg-brand-alabaster border border-gray-200 rounded-full text-sm font-bold font-mono text-gray-600">{zip}</span>
              ))}
              {zipArray.length > 5 && (
                <span class="px-3 py-1 bg-gray-50 border border-gray-200 rounded-full text-sm font-bold font-sans text-gray-500">+{zipArray.length - 5} more</span>
              )}
            </div>
          </div>
        )}
      </div>
    </div>
  </div>
</section>
