---
interface Props {
  city: string;
  state: string;
  zips: string;
  population?: string;
  serviceTitle: string;
}

const { city, state, zips, population, serviceTitle } = Astro.props;

// Convert zips string "12345|12346" to array and format for display
const zipArray = zips ? zips.split('|').filter(z => z.trim().length > 0) : [];
const zipDisplay = zipArray.length > 5 
  ? `${zipArray.slice(0, 5).join(', ')}, and surrounding areas` 
  : zipArray.join(', ');

// Optional population context
const popContext = population && parseInt(population) > 50000 
  ? ` serving the growing community of over ${Number(population).toLocaleString()} residents`
  : '';
---

<div class="bg-white py-12 md:py-16">
  <div class="max-w-[90rem] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <h2 class="text-3xl font-heading font-bold uppercase text-brand-charcoal mb-6">Service Area Coverage in {city}</h2>
      <p class="text-lg font-sans text-gray-700 leading-relaxed mb-6">
        When you need professional {serviceTitle.toLowerCase()} in {city}, {state}{popContext}, timely response and reliable expertise matter. Kivo Garage Door Services delivers comprehensive solutions designed to handle the specific structural and climate demands of the region. Whether addressing an unexpected breakdown or planning a major exterior upgrade, professional service restores functionality and enhances home security.
      </p>
      
      {zipDisplay && (
        <div class="bg-brand-alabaster p-6 rounded-sm border border-gray-100 mt-8">
          <h3 class="font-bold font-sans text-brand-charcoal mb-3">Coverage includes zip codes:</h3>
          <p class="font-mono text-sm text-gray-600 leading-relaxed">
            {zipDisplay}
          </p>
        </div>
      )}
    </div>
  </div>
</div>
