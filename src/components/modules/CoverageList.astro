---
import { getCollection } from 'astro:content';
import Eyebrow from '../ui/Eyebrow.astro';

interface Props {
  eyebrow?: string;
  stateFilter?: string;
  headline?: string;
}

const { eyebrow, stateFilter, headline = "Our Service Coverage" } = Astro.props;

// Fetch locations
const allLocations = await getCollection('locations');
let activeLocations = allLocations.filter(loc => loc.data.status === 'priority' || loc.data.status === 'indexable');

const locationsToRender = stateFilter 
  ? activeLocations.filter(loc => loc.data.state.toLowerCase() === stateFilter.toLowerCase())
  : activeLocations;

// Group by state if no stateFilter is provided, else just list cities
const grouped = locationsToRender.reduce((acc, loc) => {
  const state = loc.data.state.toUpperCase();
  if (!acc[state]) acc[state] = [];
  acc[state].push(loc);
  return acc;
}, {} as Record<string, typeof activeLocations>);

// Sort states and cities
const states = Object.keys(grouped).sort();
states.forEach(state => {
  grouped[state].sort((a, b) => a.data.city.localeCompare(b.data.city));
});
---

<section class="py-20 md:py-32 bg-gradient-to-br from-brand-charcoal to-black text-white relative overflow-hidden">
  <div class="absolute inset-0 z-0 opacity-20 pointer-events-none" style="background-image: radial-gradient(circle at center, #ffffff 1px, transparent 1px); background-size: 40px 40px;"></div>
  <div class="max-w-[90rem] mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-20 flex flex-col items-center">
      {eyebrow && <Eyebrow text={eyebrow} centered={true} className="!text-brand-accent-alt" />}
      <h2 class="text-4xl md:text-5xl font-heading font-black uppercase tracking-tight text-white mb-6 leading-[1.1]">{headline}</h2>
      <p class="text-xl text-gray-400 font-sans leading-relaxed">We connect homeowners with professional, reliable garage door services across our active coverage areas.</p>
    </div>

    <div class={`grid gap-8 ${states.length === 1 ? 'grid-cols-1' : 'grid-cols-1 md:grid-cols-2 lg:grid-cols-3'}`}>
      {states.map(state => (
        <div class="bg-white/5 rounded-3xl p-8 border border-white/10 shadow-2xl backdrop-blur-md">
          <h3 class="text-2xl font-heading font-bold text-white mb-8 flex items-center gap-3">
            <span class="w-8 h-8 rounded-full bg-brand-accent/20 flex items-center justify-center text-brand-accent">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" /></svg>
            </span>
            {stateFilter ? 'Service Cities' : state}
          </h3>
          <ul class={`grid gap-3 ${states.length === 1 ? 'grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4' : 'grid-cols-1'}`}>
            {grouped[state].map(loc => (
              <li>
                <a href={`/${loc.data.state.toLowerCase()}/garage-door-repair-${loc.data.slug.split('/')[1]}/`} class="group flex items-center justify-between p-3 rounded-xl bg-white/5 hover:bg-white/10 hover:shadow-md transition-all duration-300 text-gray-300 hover:text-white font-sans font-medium">
                  <span class="flex items-center gap-3">
                    <span class="w-1.5 h-1.5 bg-brand-accent/50 group-hover:bg-brand-accent rounded-full transition-colors"></span>
                    {loc.data.city}
                  </span>
                  <svg class="w-4 h-4 text-gray-500 group-hover:text-brand-accent transform group-hover:translate-x-1 transition-all duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
