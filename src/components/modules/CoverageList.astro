---
import { getCollection } from 'astro:content';
import Eyebrow from '../ui/Eyebrow.astro';

interface Props {
  eyebrow?: string;
  stateFilter?: string;
  headline?: string;
}

const { eyebrow, stateFilter, headline = "Our Service Coverage" } = Astro.props;

// Fetch locations
const allLocations = await getCollection('locations');
let activeLocations = allLocations.filter(loc => loc.data.status === 'priority' || loc.data.status === 'indexable');

const locationsToRender = stateFilter 
  ? activeLocations.filter(loc => loc.data.state.toLowerCase() === stateFilter.toLowerCase())
  : activeLocations;

// Group by state if no stateFilter is provided, else just list cities
const grouped = locationsToRender.reduce((acc, loc) => {
  const state = loc.data.state.toUpperCase();
  if (!acc[state]) acc[state] = [];
  acc[state].push(loc);
  return acc;
}, {} as Record<string, typeof activeLocations>);

// Sort states and cities
const states = Object.keys(grouped).sort();
states.forEach(state => {
  grouped[state].sort((a, b) => a.data.city.localeCompare(b.data.city));
});
---

<section class="py-16 md:py-24 bg-brand-charcoal text-white border-b border-gray-900">
  <div class="max-w-[90rem] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16 flex flex-col items-center">
      {eyebrow && <Eyebrow text={eyebrow} centered={true} className="text-gray-400" />}
      <h2 class="text-3xl md:text-4xl font-heading font-bold uppercase tracking-tight text-white">{headline}</h2>
      <div class="w-24 h-1 bg-brand-accent mx-auto mt-6"></div>
      <p class="mt-6 text-gray-300 font-sans text-lg">We connect homeowners with professional, reliable garage door services across our active coverage areas.</p>
    </div>

    <div class={`grid gap-12 ${states.length === 1 ? 'grid-cols-1' : 'grid-cols-1 md:grid-cols-2 lg:grid-cols-3'}`}>
      {states.map(state => (
        <div class="bg-gray-800 rounded-sm p-6 border border-gray-700">
          <h3 class="text-2xl font-heading font-bold text-white mb-6 border-b border-gray-600 pb-2">
            {stateFilter ? 'Service Cities' : state}
          </h3>
          <ul class={`grid gap-4 ${states.length === 1 ? 'grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4' : 'grid-cols-1'}`}>
            {grouped[state].map(loc => (
              <li>
                <a href={`/${loc.data.state.toLowerCase()}/garage-door-repair-${loc.data.slug.split('/')[1]}/`} class="text-gray-300 hover:text-brand-accent transition-colors font-sans flex items-center">
                  <span class="w-1.5 h-1.5 bg-brand-accent rounded-full mr-3"></span>
                  {loc.data.city}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
