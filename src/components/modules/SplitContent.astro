---
import PhoneCTA from '../ui/PhoneCTA.astro';
import Eyebrow from '../ui/Eyebrow.astro';

interface Props {
  eyebrow?: string;
  headline: string;
  subheadline?: string;
  imageSrc: string;
  imageAlt: string;
  imageRight?: boolean;
}

const { eyebrow, headline, subheadline, imageSrc, imageAlt, imageRight = false } = Astro.props;
---

<section class="py-16 md:py-24 bg-white border-b border-gray-100">
  <div class="max-w-[90rem] mx-auto px-4 sm:px-6 lg:px-8">
    <div class={`grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-start`}>
      
      <div class={`relative rounded-sm overflow-hidden shadow-xl lg:col-span-5 ${imageRight ? 'lg:order-2' : 'lg:order-1'}`}>
        <div class="relative w-full aspect-[4/3] lg:aspect-auto lg:h-[600px] xl:h-[700px]">
          <img src={imageSrc} alt={imageAlt} class="absolute lg:static inset-0 object-cover w-full h-full" loading="lazy" />
        </div>
      </div>

      <div class={`flex flex-col justify-start lg:col-span-7 ${imageRight ? 'lg:order-1' : 'lg:order-2'}`}>
        {eyebrow && <Eyebrow text={eyebrow} />}
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-brand-charcoal mb-6 uppercase tracking-tight leading-tight">
          {headline}
        </h2>
        {subheadline && (
          <p class="text-lg text-gray-700 font-sans leading-relaxed mb-6">
            {subheadline}
          </p>
        )}
        <slot />
        <div class="mt-8">
          <PhoneCTA label="Call for Professional Service" />
        </div>
      </div>

    </div>
  </div>
</section>
