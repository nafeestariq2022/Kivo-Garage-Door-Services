---
import PhoneCTA from '../ui/PhoneCTA.astro';
import Eyebrow from '../ui/Eyebrow.astro';

interface Props {
  eyebrow?: string;
  headline: string;
  subheadline?: string;
  imageSrc: string;
  imageAlt: string;
  imageRight?: boolean;
}

const { eyebrow, headline, subheadline, imageSrc, imageAlt, imageRight = false } = Astro.props;
---

<section class="py-20 md:py-32 bg-brand-alabaster relative overflow-hidden">
  <div class="max-w-[90rem] mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class={`grid grid-cols-1 lg:grid-cols-12 gap-16 lg:gap-24 items-center`}>
      
      <!-- Image Side -->
      <div class={`relative lg:col-span-6 ${imageRight ? 'lg:order-2' : 'lg:order-1'}`}>
        <!-- Decorative blob -->
        <div class="absolute -top-10 -left-10 w-48 h-48 bg-brand-accent/10 rounded-full blur-3xl z-0"></div>
        <div class="absolute -bottom-10 -right-10 w-48 h-48 bg-brand-charcoal/10 rounded-full blur-3xl z-0"></div>
        
        <div class="relative z-10 rounded-3xl overflow-hidden shadow-2xl ring-4 ring-white">
          <div class="relative w-full aspect-[4/3] lg:aspect-square">
            <img src={imageSrc} alt={imageAlt} class="absolute inset-0 object-cover w-full h-full hover:scale-105 transition-transform duration-700 ease-out" loading="lazy" />
          </div>
        </div>
      </div>

      <!-- Text Side -->
      <div class={`flex flex-col justify-start lg:col-span-6 ${imageRight ? 'lg:order-1' : 'lg:order-2'}`}>
        {eyebrow && <Eyebrow text={eyebrow} />}
        <h2 class="text-4xl md:text-5xl font-heading font-black text-brand-charcoal mb-8 uppercase tracking-tight leading-[1.1]">
          {headline}
        </h2>
        {subheadline && (
          <p class="text-lg md:text-xl text-gray-600 font-sans leading-relaxed mb-6">
            {subheadline}
          </p>
        )}
        <div class="prose prose-lg prose-p:text-gray-600 prose-p:leading-relaxed max-w-none">
          <slot />
        </div>
        <div class="mt-10">
          <PhoneCTA label="Call for Professional Service" />
        </div>
      </div>

    </div>
  </div>
</section>
