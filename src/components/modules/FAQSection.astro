---
import { generateSEO } from '../../utils/seo';
import Eyebrow from '../ui/Eyebrow.astro';

interface FAQ {
  question: string;
  answer: string;
}

interface Props {
  eyebrow?: string;
  faqs: FAQ[];
  city?: string;
  state?: string;
}

const { eyebrow, faqs, city, state } = Astro.props;

// We do NOT output FAQPage schema here directly to keep head manipulation clean.
// We'll pass the processed FAQs up, or let the main layout handle the JSON-LD.
---

{faqs && faqs.length > 0 && (
  <section class="bg-brand-alabaster py-20 md:py-32 faq-section relative">
    <div class="max-w-[90rem] mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-4xl mx-auto flex flex-col items-center">
        {eyebrow && <Eyebrow text={eyebrow} centered={true} />}
        <h2 class="text-4xl md:text-5xl font-heading font-black uppercase text-brand-charcoal mb-12 text-center tracking-tight w-full leading-[1.1]">Frequently Asked Questions</h2>
        <div class="space-y-6 w-full">
          {faqs.map((faq, index) => {
            const q = generateSEO(faq.question, { city: city || '', state: state || '' });
            const a = generateSEO(faq.answer, { city: city || '', state: state || '' });
            return (
              <div class="bg-white rounded-3xl shadow-sm hover:shadow-md transition-shadow border border-gray-100 overflow-hidden focus-within:ring-2 focus-within:ring-brand-accent focus-within:ring-offset-2">
                <button 
                  type="button" 
                  class="faq-button w-full px-8 py-6 text-left flex justify-between items-center focus:outline-none group transition-colors"
                  aria-expanded="false"
                  aria-controls={`faq-answer-${index}`}
                  id={`faq-question-${index}`}
                >
                  <span class="text-xl font-bold font-sans text-brand-charcoal pr-4 group-hover:text-brand-accent transition-colors">{q}</span>
                  <span class="faq-icon flex-shrink-0 w-10 h-10 bg-brand-alabaster rounded-full flex items-center justify-center text-brand-accent transition-transform duration-300 group-hover:bg-brand-accent/10">
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-6-6h12" />
                    </svg>
                  </span>
                </button>
                <div 
                  id={`faq-answer-${index}`} 
                  role="region" 
                  aria-labelledby={`faq-question-${index}`} 
                  class="faq-content grid transition-[grid-template-rows] duration-300 ease-in-out"
                  style="grid-template-rows: 0fr;"
                >
                  <div class="overflow-hidden">
                    <div class="px-8 pb-8 pt-2 text-gray-600 font-sans leading-relaxed text-lg">
                      {a}
                    </div>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </section>
)}

<script>
  function initFAQs() {
    const sections = document.querySelectorAll('.faq-section');
    sections.forEach(section => {
      const buttons = section.querySelectorAll('.faq-button');
      buttons.forEach(button => {
        button.replaceWith(button.cloneNode(true));
      });
      
      const newButtons = section.querySelectorAll('.faq-button');
      newButtons.forEach(button => {
        button.addEventListener('click', () => {
          const expanded = button.getAttribute('aria-expanded') === 'true';
          const contentId = button.getAttribute('aria-controls');
          const content = document.getElementById(contentId);
          const iconContainer = button.querySelector('.faq-icon');
          const iconPath = button.querySelector('path');
          
          if (!content || !iconPath) return;

          if (expanded) {
            button.setAttribute('aria-expanded', 'false');
            content.style.gridTemplateRows = '0fr';
            iconPath.setAttribute('d', 'M12 6v12m-6-6h12'); // Plus
            if(iconContainer) iconContainer.classList.remove('rotate-180');
          } else {
            button.setAttribute('aria-expanded', 'true');
            content.style.gridTemplateRows = '1fr';
            iconPath.setAttribute('d', 'M20 12H4'); // Minus
            if(iconContainer) iconContainer.classList.add('rotate-180');
          }
        });
      });
    });
  }

  // Initialize on load and on Astro view transitions
  initFAQs();
  document.addEventListener('astro:page-load', initFAQs);
</script>
