---
import { generateSEO } from '../../utils/seo';
import PhoneCTA from '../ui/PhoneCTA.astro';
import Eyebrow from '../ui/Eyebrow.astro';

interface Props {
  eyebrow?: string;
  h1Template: string;
  subtitleTemplate: string;
  imageSrc: string;
  imageAlt: string;
  city: string;
  state: string;
}

const { eyebrow, h1Template, subtitleTemplate, imageSrc, imageAlt, city, state } = Astro.props;

const h1Text = generateSEO(h1Template, { city, state });
const subtitleText = generateSEO(subtitleTemplate, { city, state });
---

<section class="relative w-full bg-brand-alabaster pt-12 pb-16 lg:pt-20 lg:pb-24 border-b border-gray-200 overflow-hidden">
  <div class="max-w-[90rem] mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
    <div class="lg:col-span-7 z-10 lg:pr-4 flex flex-col items-start">
      {eyebrow && <Eyebrow text={eyebrow} />}
      <h1 class="text-4xl md:text-5xl lg:text-[3.5rem] xl:text-[4rem] 2xl:text-[4.5rem] font-heading font-bold uppercase text-brand-charcoal mb-6 leading-[1.05] tracking-tight">
        {h1Text}
      </h1>
      <p class="text-lg md:text-xl font-sans text-gray-700 leading-relaxed mb-8 max-w-2xl">
        {subtitleText}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 mt-8">
        <PhoneCTA label="Call Now for Local Service" />
      </div>
    </div>
    
    <div class="lg:col-span-5 relative mt-12 lg:mt-0">
      <div class="aspect-w-4 aspect-h-3 lg:aspect-w-3 lg:aspect-h-4 xl:aspect-w-4 xl:aspect-h-5">
        <img src={imageSrc} alt={imageAlt} class="object-cover w-full h-full rounded-sm shadow-xl" loading="eager" />
      </div>
      <div class="absolute -bottom-6 -left-6 w-32 h-32 border-l-4 border-b-4 border-brand-accent hidden lg:block z-0"></div>
    </div>
  </div>
</section>
