---
import { generateSEO } from '../../utils/seo';
import PhoneCTA from '../ui/PhoneCTA.astro';
import Eyebrow from '../ui/Eyebrow.astro';

interface Props {
  eyebrow?: string;
  h1Template: string;
  subtitleTemplate: string;
  imageSrc: string;
  imageAlt: string;
  city: string;
  state: string;
}

const { eyebrow, h1Template, subtitleTemplate, imageSrc, imageAlt, city, state } = Astro.props;

const h1Text = generateSEO(h1Template, { city, state });
const subtitleText = generateSEO(subtitleTemplate, { city, state });
---

<section class="relative w-full pt-16 pb-24 lg:pt-32 lg:pb-40 overflow-hidden bg-gradient-to-br from-brand-alabaster via-white to-gray-50">
  <!-- Modern subtle background glow -->
  <div class="absolute top-0 left-0 w-full h-full overflow-hidden z-0 pointer-events-none">
    <div class="absolute -top-[20%] -left-[10%] w-[50%] h-[50%] rounded-full bg-brand-accent/5 blur-[120px]"></div>
    <div class="absolute top-[40%] -right-[10%] w-[40%] h-[60%] rounded-full bg-brand-charcoal/5 blur-[120px]"></div>
  </div>

  <div class="max-w-[90rem] mx-auto px-4 sm:px-6 lg:px-8 relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-16 lg:gap-20 items-center">
    <!-- Left: Typography -->
    <div class="lg:col-span-6 flex flex-col items-start">
      {eyebrow && <Eyebrow text={eyebrow} />}
      <h1 class="text-4xl md:text-5xl lg:text-6xl xl:text-[4.5rem] 2xl:text-7xl font-heading font-black text-brand-charcoal leading-[1.1] uppercase tracking-tight">
        {h1Text}
      </h1>
      <p class="mt-6 text-lg lg:text-xl font-sans text-gray-600 leading-relaxed max-w-2xl">
        {subtitleText}
      </p>
      <div class="mt-10 flex flex-col sm:flex-row gap-4">
        <PhoneCTA label="Call for Local Service" />
      </div>
      
      <!-- Elevated White Pills -->
      <div class="mt-10 sm:mt-12 flex flex-wrap items-center gap-4">
        <span class="group inline-flex items-center gap-3 px-5 py-2.5 bg-white rounded-full shadow-[0_8px_30px_rgb(0,0,0,0.06)] text-brand-charcoal text-sm font-bold tracking-wide transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_8px_30px_rgb(0,0,0,0.12)]">
          <div class="flex items-center justify-center w-6 h-6 rounded-full bg-brand-accent/10 transition-colors duration-300 group-hover:bg-brand-accent text-brand-accent group-hover:text-white">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>
          </div>
          Local Expert
        </span>
        <span class="group inline-flex items-center gap-3 px-5 py-2.5 bg-white rounded-full shadow-[0_8px_30px_rgb(0,0,0,0.06)] text-brand-charcoal text-sm font-bold tracking-wide transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_8px_30px_rgb(0,0,0,0.12)]">
          <div class="flex items-center justify-center w-6 h-6 rounded-full bg-brand-accent/10 transition-colors duration-300 group-hover:bg-brand-accent text-brand-accent group-hover:text-white">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>
          </div>
          Same-Day Service
        </span>
        <span class="group inline-flex items-center gap-3 px-5 py-2.5 bg-white rounded-full shadow-[0_8px_30px_rgb(0,0,0,0.06)] text-brand-charcoal text-sm font-bold tracking-wide transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_8px_30px_rgb(0,0,0,0.12)]">
          <div class="flex items-center justify-center w-6 h-6 rounded-full bg-brand-accent/10 transition-colors duration-300 group-hover:bg-brand-accent text-brand-accent group-hover:text-white">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>
          </div>
          Guaranteed
        </span>
      </div>
    </div>
    
    <!-- Right: Image with Floating Glassmorphism Element -->
    <div class="lg:col-span-6 relative mt-12 lg:mt-0 group perspective">
      <div class="relative w-full aspect-square lg:aspect-[4/3] rounded-3xl overflow-hidden shadow-2xl ring-4 ring-white transition-transform duration-700 ease-out group-hover:scale-[1.02]">
        <img src={imageSrc} alt={imageAlt} class="absolute inset-0 object-cover w-full h-full transition-transform duration-1000 ease-in-out group-hover:scale-105" loading="eager" />
      </div>
      
      <!-- Floating Glassmorphism Location Badge -->
      <div class="absolute -bottom-8 -left-8 md:bottom-8 md:-left-12 bg-white/80 backdrop-blur-md border border-white/50 shadow-xl rounded-2xl p-5 flex items-center gap-4 z-20 animate-fade-in-up">
        <div class="flex-shrink-0 w-12 h-12 bg-brand-accent rounded-full flex items-center justify-center text-white">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
        </div>
        <div>
          <p class="text-sm font-bold text-brand-charcoal">Serving {city}</p>
          <p class="text-xs text-gray-500 font-medium mt-0.5">Top-rated in {state}</p>
        </div>
      </div>
    </div>
  </div>
</section>
