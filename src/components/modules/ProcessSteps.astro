---
import Eyebrow from '../ui/Eyebrow.astro';

interface Step {
  title: string;
  description: string;
}

interface Props {
  eyebrow?: string;
  headline?: string;
  steps: Step[];
  bg?: 'white' | 'alabaster';
}

const { eyebrow, headline = "How Our Service Works", steps, bg = 'alabaster' } = Astro.props;

const bgClass = bg === 'white' ? 'bg-white' : 'bg-brand-alabaster';
---

<section class={`py-16 md:py-24 border-b border-gray-100 ${bgClass}`}>
  <div class="max-w-[90rem] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16 flex flex-col items-center">
      {eyebrow && <Eyebrow text={eyebrow} centered={true} />}
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-brand-charcoal uppercase tracking-tight">{headline}</h2>
      <div class="w-24 h-1 bg-brand-accent mx-auto mt-6"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      {steps.map((step, index) => (
        <div class="relative bg-white p-8 rounded-sm shadow-sm border border-gray-200">
          <div class="absolute -top-4 -left-4 w-12 h-12 bg-brand-charcoal text-white font-heading font-bold text-xl flex items-center justify-center rounded-sm shadow-md">
            {index + 1}
          </div>
          <h3 class="text-xl font-heading font-bold text-brand-charcoal mt-2 mb-3">{step.title.replace(/^\d+\.\s*/, '')}</h3>
          <p class="text-gray-700 font-sans leading-relaxed">{step.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
